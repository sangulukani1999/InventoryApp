<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main app theme (Light only, no dark mode) -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Prevent automatic dark mode -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- Status bar and nav bar colors -->
        <item name="android:statusBarColor">@color/nav_bar_color</item>
        <item name="android:navigationBarColor">@color/nav_bar_color</item>

        <!-- Control icon visibility -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="CustomSearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Add these styles -->
    <style name="FinancialLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="FinancialLabel.Bold" parent="FinancialLabel">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FinancialFigure">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="FinancialFigure.Bold" parent="FinancialFigure">
        <item name="android:textStyle">bold</item>
    </style>



</resources>
