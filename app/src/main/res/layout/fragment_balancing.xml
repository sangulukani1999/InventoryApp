<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".balancing">

    <!-- Header Card -->

    <!-- Filter Dropdown (Spinner) -->
    <Spinner
        android:id="@+id/date_filter_spinner"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Financial Details using a Guideline for alignment -->

    <!-- Labels Column -->
    <TextView
        android:id="@+id/sales_label"
        style="@style/FinancialLabel"
        android:layout_marginTop="16dp"
        android:text="Sales"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/date_filter_spinner" />

    <TextView
        android:id="@+id/opening_balance_label"
        style="@style/FinancialLabel"
        android:layout_marginTop="12dp"
        android:text="Opening Balance"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sales_label" />

    <TextView
        android:id="@+id/investment_label"
        style="@style/FinancialLabel"
        android:layout_marginTop="12dp"
        android:text="Any Investment"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/opening_balance_label" />

    <TextView
        android:id="@+id/expenses_label"
        style="@style/FinancialLabel"
        android:layout_marginTop="12dp"
        android:text="Less: Expenses"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/investment_label" />

    <View
        android:id="@+id/divider1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/expenses_label" />

    <TextView
        android:id="@+id/expected_cash_label"
        style="@style/FinancialLabel.Bold"
        android:layout_marginTop="8dp"
        android:text="Expected Cash"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider1" />

    <TextView
        android:id="@+id/available_cash_label"
        style="@style/FinancialLabel"
        android:layout_marginTop="12dp"
        android:text="Available Cash"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/expected_cash_label" />

    <View
        android:id="@+id/divider2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/available_cash_label" />

    <TextView
        android:id="@+id/shortages_label"
        style="@style/FinancialLabel.Bold"
        android:layout_marginTop="8dp"
        android:text="Shortage / Overage"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider2" />

    <!-- Figures Column -->
    <TextView
        android:id="@+id/sales_figure"
        style="@style/FinancialFigure"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/sales_label"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="1,250.00" />

    <TextView
        android:id="@+id/opening_balance_figure"
        style="@style/FinancialFigure"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/opening_balance_label"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="500.00" />

    <TextView
        android:id="@+id/any_investment_figure"
        style="@style/FinancialFigure"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/investment_label"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="100.00" />

    <TextView
        android:id="@+id/less_expenses_figure"
        style="@style/FinancialFigure"
        android:layout_marginEnd="16dp"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/expenses_label"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="(200.00)" />

    <TextView
        android:id="@+id/expected_cash_figure"
        style="@style/FinancialFigure.Bold"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/expected_cash_label"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="1,650.00" />

    <TextView
        android:id="@+id/available_cash_figure"
        style="@style/FinancialFigure"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/available_cash_label"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="1,645.00" />

    <TextView
        android:id="@+id/shortages_figure"
        style="@style/FinancialFigure.Bold"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/shortages_label"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="(5.00)" />


    <!-- Bottom Summary Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/summary_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#EFEFEF"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/capital_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Capital"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/capital_figure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    tools:text="3,545.00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profit_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gross Profit"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/profit_figure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    tools:text="800.00" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/syncButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Sync"
        app:layout_constraintBottom_toTopOf="@+id/summary_card"
        app:layout_constraintStart_toStartOf="@+id/summary_card" />

</androidx.constraintlayout.widget.ConstraintLayout>
