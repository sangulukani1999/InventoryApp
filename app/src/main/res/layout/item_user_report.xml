<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- User Info Header -->
        <TextView
            android:id="@+id/userNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="John Doe"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/userEmailTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="john.doe@example.com"
            android:textSize="12sp" />

        <!-- Outstanding Liability -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Outstanding Liability:"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/outstandingLiabilityTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00"
                android:textColor="@color/variance_negative"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ✅ START: NEW VARIANCE SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Variances Attributed:"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/variancesTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00"
                android:textColor="@android:color/holo_orange_dark"
                android:textStyle="bold" />
        </LinearLayout>
        <!-- ✅ END: NEW VARIANCE SECTION -->


        <!-- Today's Report -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Today"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Shortage:" />

            <TextView
                android:id="@+id/todayShortageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00" />
        </LinearLayout>

        <!-- PAYMENT SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pay Liability:" />

            <!-- EditText for admins to enter payment amount -->
            <EditText
                android:id="@+id/todayPaidEditText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:hint="K0.00"
                android:inputType="numberDecimal"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Button for admins to confirm the payment -->
            <Button
                android:id="@+id/confirmPaidButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Confirm"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
        <!-- END PAYMENT SECTION -->


        <!-- This Month's Report -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="This Month"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Shortages:" />

            <TextView
                android:id="@+id/monthShortagesTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Paid:" />

            <TextView
                android:id="@+id/monthPaidTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
