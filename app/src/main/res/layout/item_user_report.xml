<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:animateLayoutChanges="true"
        android:padding="16dp">

        <!-- User Info Header -->
        <TextView
            android:id="@+id/userNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="John Doe"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/userEmailTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="john.doe@example.com"
            android:textSize="12sp" />

        <!-- Outstanding Liability -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Outstanding Liability:"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/outstandingLiabilityTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00"
                android:textColor="@color/variance_negative"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Variances Attributed (All Time Net) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Net Variances (All Time):"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/variancesTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00"
                android:textColor="@android:color/holo_orange_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Surpluses This Month (Credit): -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Surpluses This Month (Credit):"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/monthPositiveVariancesTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00"
                android:textColor="@color/variance_positive"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PAYMENT SECTION (This part remains as you had it) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Today"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Shortage:"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/todayShortageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pay Liability:"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/todayPaidEditText"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:hint="K0.00"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/confirmPaidButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Confirm"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- This Month's Report (This part remains as you had it) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="This Month"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Net Liability:"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/monthShortagesTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Paid:"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/monthPaidTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K0.00"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ✅ START: ADDED COLLAPSIBLE REVIEW SECTION -->

        <!-- This is the button that triggers the expand/collapse -->
        <!-- ✅ CHANGE THIS from Button to com.google.android.material.button.MaterialButton -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reviewDetailsButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Review Transactions"
            android:textAllCaps="false"
            app:icon="@drawable/drop_down_option_arrow"
            app:iconGravity="end" />

        <!-- This is the container that will be shown or hidden -->
        <LinearLayout
            android:id="@+id/collapsibleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Nested RecyclerView to show the transaction list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/transactionsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_user_transaction" /> <!-- You need to create this layout -->

            <!-- Pagination control section -->
            <LinearLayout
                android:id="@+id/paginationControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/prevButton"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:enabled="false"
                    android:text="Prev" />

                <TextView
                    android:id="@+id/pageInfoTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Page 1 of 1"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/nextButton"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Next"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <!-- ✅ END: ADDED COLLAPSIBLE REVIEW SECTION -->

        <!-- This is your original review/status section at the bottom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.cardview.widget.CardView
                    android:id="@+id/UserWorkingStatus"
                    android:layout_width="10sp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/variance_positive"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/reviewFilter"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/review_button"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    app:cardBackgroundColor="#0071c1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/textView56"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Review"
                            android:textColor="#fff"
                            android:textSize="11sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textView58"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Working Status:"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="@+id/UserWorkingStatus"
                    app:layout_constraintEnd_toStartOf="@+id/UserWorkingStatus"
                    app:layout_constraintTop_toTopOf="@+id/UserWorkingStatus" />

                <Spinner
                    android:id="@+id/reviewFilter"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/spinner_border"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/drop_down_option_arrow"
                    app:layout_constraintBottom_toBottomOf="@+id/reviewFilter"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/reviewFilter"
                    app:layout_constraintVertical_bias="0.571" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
