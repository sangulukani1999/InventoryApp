<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Force night mode to use light theme -->
    <style name="Base.Theme.Zed" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor">@color/nav_bar_color</item>
        <item name="android:navigationBarColor">@color/nav_bar_color</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Zed" parent="Base.Theme.Zed" />

</resources>
