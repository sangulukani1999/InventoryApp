<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bottom layer: gradient border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4285F4"
                android:endColor="#6AAEFF"
                android:angle="0" />
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Top layer: white fill with inset -->
    <item android:left="5dp" android:right="5dp" android:top="5dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#f4f6ff" />
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

</layer-list>
